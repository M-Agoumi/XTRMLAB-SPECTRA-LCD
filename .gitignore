# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Run output -------------------------------------------------------
# The .bat wrappers overwrite these on every run; they are session
# transcripts, not source. Copy anything worth keeping into FINDINGS.md.
test_output.log
diag_output.log
diag2_output.log
drawlab_output.log
*.log

# --- Local scratch ----------------------------------------------------
*.bak
*.tmp
*.orig
*.rej

# --- Vendor material (do NOT commit) ----------------------------------
# app.asar is ~58 MB of the vendor's proprietary Electron bundle. It was
# the reference for the protocol, but it is their copyrighted code and has
# no business in this repo -- FINDINGS.md documents the protocol instead.
# The local copy lives in Downloads\turing-screen\.
*.asar
app.asar.unpacked/

# --- Editors / OS -----------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
