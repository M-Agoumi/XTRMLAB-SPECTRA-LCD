# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Run output -------------------------------------------------------
# The .bat wrappers overwrite these on every run; they are session
# transcripts, not source. Copy anything worth keeping into FINDINGS.md.
test_output.log
diag_output.log
diag2_output.log
drawlab_output.log
*.log

# --- Local scratch ----------------------------------------------------
*.bak
*.tmp
*.orig
*.rej

# --- Personal settings & media (never commit) --------------------------
# app_config.json holds your own port, brightness, and local file paths
# (video/image locations on your machine) -- machine-specific, not source.
# The app creates it fresh on first run if it's missing.
app_config.json
Launch Hongtai Screen.vbs

# Nothing here ships with a bundled video or "nothing playing" image on
# purpose (see the Dashboard/Video tabs' file pickers) -- your own picks
# stay out of the repo. Add your own filenames here too if you keep them
# in this folder instead of elsewhere.
badapple.mp4
default_spotify.jpeg
*.mp4
*.mkv
*.avi
*.mov

# --- Vendor material (do NOT commit) ----------------------------------
# app.asar is ~58 MB of the vendor's proprietary Electron bundle. It was
# the reference for the protocol, but it is their copyrighted code and has
# no business in this repo -- FINDINGS.md documents the protocol instead.
# The local copy lives in Downloads\turing-screen\.
*.asar
app.asar.unpacked/

# --- PyInstaller build output ------------------------------------------
# Generated by `pyinstaller hongtai_screen.spec` (see BUILD.md) -- build
# products, not source; rebuild them, don't commit them.
build/
build_venv/
dist/
*.spec.bak

# --- Editors / OS -----------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
